{# Gift Card configuration — module.configuration hook fragment (Twig BO) #}
<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <h2 class="card-title h5 mb-0 flex-grow-1">
            {{ 'Gift Card gestion'|trans({}, 'theliagiftcard.bo.default') }}
        </h2>
        <a class="btn btn-secondary btn-sm me-2" title="{{ 'Configuration'|trans({}, 'theliagiftcard.bo.default') }}"
           href="#config_card_gift_dialog" data-bs-toggle="modal">
            <i class="bi bi-gear"></i>
        </a>
        <a class="btn btn-primary btn-sm" title="{{ 'Create a new gift card'|trans({}, 'theliagiftcard.bo.default') }}"
           href="#manualy_create_card_gift_dialog" data-bs-toggle="modal">
            <i class="bi bi-plus-lg"></i>
        </a>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3">
                <label for="js-input-type" class="form-label">
                    {{ 'Filtrer par type :'|trans({}, 'theliagiftcard.bo.default') }}
                </label>
                <select id="js-input-type" class="form-select js-refresh-table" data-default="">
                    <option value="0">{{ 'Purchased / Generated'|trans({}, 'theliagiftcard.bo.default') }}</option>
                    <option value="1">{{ 'Purchased'|trans({}, 'theliagiftcard.bo.default') }}</option>
                    <option value="2">{{ 'Generated by Admin'|trans({}, 'theliagiftcard.bo.default') }}</option>
                </select>
            </div>
        </div>

        <table id="dataTableGiftCard" width="100%" class="table table-bordered table-hover"
               summary="{{ 'List of Gift Card'|trans({}, 'theliagiftcard.bo.default') }}">
            <thead>
                <tr>
                    {% for definition in columnsDefinitionTransaction|default([]) %}
                        <th>{{ definition.title }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

{% include 'TheliaGiftCard/modal/modal-send-gift-card-by-email.html.twig' with { form: email_form } only %}
{% include 'TheliaGiftCard/modal/modal_manualy_create_gift_card.html.twig' with { form: create_form } only %}
{% include 'TheliaGiftCard/modal/modal_edit_create_gift_card.html.twig' with { form: edit_form } only %}
{% include 'TheliaGiftCard/modal/config_gift_card.html.twig' with { form: config_form } only %}
