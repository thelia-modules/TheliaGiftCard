{# Gift Card configuration, module.configuration hook fragment (Twig BO). The list is laid out like the
   order list of default-twig: a search, chips for the type and the status, a BoDataTable and a
   BoPagination, all server side and driven by the query string of this page. Rows by
   GiftCardListRowPresenter, chips and links by GiftCardListFilterPresenter. #}
{% set domain = 'theliagiftcard.bo.default-twig' %}
{% set module_url = path('admin.module.configure', { module_code: 'TheliaGiftCard' }) %}

{% set type_labels = {
    all: 'Purchased / Generated'|trans({}, domain),
    purchased: 'Purchased'|trans({}, domain),
    generated: 'Generated by Admin'|trans({}, domain),
} %}
{% set status_labels = {
    all: 'All statuses'|trans({}, domain),
    active: 'Active'|trans({}, domain),
    inactive: 'Not active'|trans({}, domain),
} %}

<div class="mb-3" data-testid="gift-card-list">
    {# The header of _page_header.html.twig, with an h2: the module configuration page has its h1. #}
    <div class="bo-page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h4 mb-0">{{ 'Gift Card gestion'|trans({}, domain) }}</h2>
        <div class="d-flex flex-wrap align-items-center gap-2 bo-page-header__actions">
            <a class="btn btn-sm btn-outline-secondary" href="#config_card_gift_dialog" data-bs-toggle="modal" data-testid="gift-card-config">
                <i class="bi bi-gear me-1" aria-hidden="true"></i>{{ 'Configuration'|trans({}, domain) }}
            </a>
            <a class="btn btn-sm btn-primary" href="#manualy_create_card_gift_dialog" data-bs-toggle="modal" data-testid="gift-card-create">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ 'Create a new gift card'|trans({}, domain) }}
            </a>
        </div>
    </div>

    <form method="get" action="{{ module_url }}" class="bo-order-filters" data-testid="gift-card-search-form">
        {% for name, value in filters.query_params %}
            {% if name != 'q' %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endif %}
        {% endfor %}
        <div class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label" for="gift-card-search-q">{{ 'Search'|trans({}, domain) }}</label>
                <input type="search" id="gift-card-search-q" name="q" value="{{ filters.search }}" maxlength="100"
                       class="form-control"
                       placeholder="{{ 'Code, order reference, name or e-mail of the buyer or beneficiary'|trans({}, domain) }}"
                       data-testid="gift-card-search-input">
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" data-testid="gift-card-search-submit">
                    <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans({}, domain) }}
                </button>
                <a href="{{ filters.reset_url }}" class="btn btn-outline-secondary" data-testid="gift-card-reset">{{ 'Reset'|trans({}, domain) }}</a>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <div class="d-flex flex-wrap align-items-center gap-2" role="group" aria-label="{{ 'Type'|trans({}, domain) }}" data-testid="gift-card-type-filters">
                <span class="form-label mb-0">{{ 'Type'|trans({}, domain) }}</span>
                {% for chip in filters.type_chips %}
                    <a class="btn btn-sm {{ chip.active ? 'btn-primary' : 'btn-outline-secondary' }}" href="{{ chip.url }}"
                       {% if chip.active %}aria-current="true"{% endif %}
                       data-testid="gift-card-type-{{ chip.code }}">{{ type_labels[chip.code] }}</a>
                {% endfor %}
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2" role="group" aria-label="{{ 'Status'|trans({}, domain) }}" data-testid="gift-card-status-filters">
                <span class="form-label mb-0">{{ 'Status'|trans({}, domain) }}</span>
                {% for chip in filters.status_chips %}
                    <a class="btn btn-sm {{ chip.active ? 'btn-primary' : 'btn-outline-secondary' }}" href="{{ chip.url }}"
                       {% if chip.active %}aria-current="true"{% endif %}
                       data-testid="gift-card-status-{{ chip.code }}">{{ status_labels[chip.code] }}</a>
                {% endfor %}
            </div>
        </div>
    </form>

    {# One form posts every activation and deactivation: the script points it at the card of the button
       and sends it, the answer redirects to this very page of the list. #}
    <form id="gift-card-status-form" method="post" hidden
          data-allowed-actions="{{ [path('activate_gift_card'), path('deactivate_gift_card')]|json_encode }}">
        <input type="hidden" name="_token" value="{{ assignToken() }}">
        <input type="hidden" name="list" value="{{ filters.list_query }}">
        <input type="hidden" name="code" value="">
    </form>

    {# Every action is in the row: edit, send by email, and the switch that activates or deactivates the
       card. A card that is not active is not sent. Every action needs the same right on the module: it is
       asked once for the page, not once per button, which would read the profile of a restricted
       administrator again for each of them. #}
    {% set can_update = is_granted('UPDATE', { resource: 'admin.module', module: 'TheliaGiftCard' }) %}
    {% set rows = rows|map(row => row|merge({
        _actions: not can_update ? [] : [
            row_action('edit', 'EDIT_GIFT_CARD'|trans({}, domain), modalTarget: '#manualy_edit_card_gift_dialog', dataAttributes: { code: row.code }),
        ]
        |merge(row.status ? [
            row_action('send', 'Send gift card by email'|trans({}, domain), modalTarget: '#send_gift_card_email', dataAttributes: { code: row.code }),
            row_action('deactivate', row.status_action_label, dataAttributes: { 'gift-card-status-url': row.status_url, code: row.code }),
        ] : [
            row_action('activate', row.status_action_label, dataAttributes: { 'gift-card-status-url': row.status_url, code: row.code }),
        ]),
    })) %}

    <div class="mt-3">
        {{ component('BoDataTable', {
            id: 'gift-cards',
            columns: [
                column_html('code_html', 'Code / order'|trans({}, domain), 'start', 'code', wrapHead: true),
                column_html('sponsor_html', 'Buyer'|trans({}, domain), visibleFrom: 'xl'),
                column_html('beneficiary_html', 'Beneficiary'|trans({}, domain), visibleFrom: 'lg'),
                column_badge('status', 'Status'|trans({}, domain), { 1: 'success', 0: 'secondary' }, 'start', 'status_label', null, 'status'),
                column_html('amount_html', 'Amount'|trans({}, domain), 'end', 'amount'),
                column_text('expiration_date', 'Expiry'|trans({}, domain), 'start', 'expiration_date', visibleFrom: 'lg'),
                column_html('pdf_html', 'PDF'|trans({}, domain), visibleFrom: 'md'),
                column_actions('_actions', 'Actions'|trans({}, domain)),
            ],
            rows: rows,
            emptyMessage: 'No gift card matches the current filters.'|trans({}, domain),
            sortField: filters.sort,
            sortDirection: filters.direction,
            sortKeepParams: filters.query_params,
            rowIdentifierKey: 'code',
        }) }}

        {{ component('BoPagination', {
            route: 'admin.module.configure',
            currentPage: current_page,
            lastPage: pages,
            routeParams: { module_code: 'TheliaGiftCard' }|merge(filters.query_params),
            ariaLabel: 'Gift card pagination'|trans({}, domain),
            testid: 'gift-card-pagination',
        }) }}
    </div>
</div>

{% include 'TheliaGiftCard/modal/modal-send-gift-card-by-email.html.twig' with { form: email_form, email_default_subject: email_default_subject, email_default_text: email_default_text } only %}
{% include 'TheliaGiftCard/modal/modal_manualy_create_gift_card.html.twig' with { form: create_form } only %}
{% include 'TheliaGiftCard/modal/modal_edit_create_gift_card.html.twig' with { form: edit_form } only %}
{% include 'TheliaGiftCard/modal/config_gift_card.html.twig' with { form: config_form } only %}
