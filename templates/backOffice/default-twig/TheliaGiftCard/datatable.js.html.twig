{# module.config-js hook fragment.
   Heavy jQuery + DataTables + Select2 + flatpickr table kept from CDN (no clean Stimulus port —
   server-side AJAX DataTable). jQuery loaded from CDN since the default-twig BO ships no jQuery. #}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.10/lodash.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/dataTables.bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/l10n/fr.js"></script>
<script src="https://cdn.datatables.net/plug-ins/1.10.20/dataRender/ellipsis.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/themes/airbnb.css">
<script type="application/javascript">

    {# Customer names come from customer accounts: the JSON is safe inside the script tag, and
       every value is escaped again when a cell is built from it. #}
    {% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
    var all_info = {{ all_info|json_encode(json_flags)|raw }};

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    {# Activation and deactivation are POST forms carrying the CSRF token: send the form itself, then
       redraw the table once the server has answered, on the same page. The controller answers 204 to
       this request: anything else (the login page of an expired session, a refused token, an error)
       leaves the card as it was, and says so. #}
    $('body').on('submit', '.js-gift-card-status-form', function (e) {
        e.preventDefault();

        let form = e.currentTarget;
        let button = form.querySelector('button');
        let error = document.getElementById('gift-card-status-error');

        button.setAttribute('disabled', 'disabled');
        error.classList.add('d-none');

        $.ajax({
            method: 'POST',
            url: form.action,
            data: $(form).serialize()
        }).done(function (data, textStatus, jqXHR) {
            if (204 !== jqXHR.status) {
                return failed();
            }
            $('#dataTableGiftCard').DataTable().ajax.reload(null, false);
        }).fail(failed);

        function failed() {
            error.classList.remove('d-none');
            button.removeAttribute('disabled');
        }
    });

    $('body').on('click', '.edit-gc-button', function (e) {
        e.preventDefault();
    });

    var table = $('#dataTableGiftCard').DataTable({
        scrollX: true,
        order: [[0, "desc"]],
        drawCallback: function (oSettings) {
        },
        ajax: '/admin/module/theliagiftcard/show',
        method: 'GET',
        columnDefs: {{ columnsDefinitionTransaction|json_encode(json_flags)|raw }}.concat([
            {
                targets: [0],
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                targets: [1],
                render: function (data, type, row, meta) {
                    return (data) ? '<a href="/admin/order/update/' + encodeURIComponent(data) + '">' + escapeHtml(all_info['orders'][data]) + '</a>' : "{{ 'Generated by Admin'|trans({}, 'theliagiftcard.bo.default-twig')|e('js') }}";
                }
            },
            {
                targets: [3],
                render: function (data, type, row, meta) {
                    return (data) ? escapeHtml(all_info['sponsor_customers'][data]) : escapeHtml("{{ thelia_config('store_name', '')|e('js') }}");
                }
            },
            {
                targets: [4],
                render: function (data, type, row, meta) {
                    return (data) ? escapeHtml(all_info['beneficiary_customers'][data]) : "{{ 'Not used'|trans({}, 'theliagiftcard.bo.default-twig')|e('js') }}";
                }
            },
            {
                targets: [9],
                render: function (data, type, row, meta) {
                    return (!data) ? "{{ 'Not active'|trans({}, 'theliagiftcard.bo.default-twig') }}" : "{{ 'Active'|trans({}, 'theliagiftcard.bo.default-twig') }}";
                }
            },
            {
                targets: [10],
                render: function (data, type, row, meta) {
                    let status = row[9];
                    let code = encodeURIComponent(row[2]);
                    if (status) {
                        let whole_msg = '';
                        {% for lang in all_info.languages %}
                        whole_msg += '<a class="btn btn-secondary btn-sm" ' +
                            'href="/admin/module/theliagiftcard/config/send/pdf?l={{ lang.locale }}&code=' + code + '" ' +
                            'title="{{ 'GENERATE_PDF_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default-twig') }}" ' +
                            'target="_blank">{{ lang.code }}</a> ';
                        {% endfor %}
                        return whole_msg;
                    } else
                        return "";
                }
            },
            {
                targets: [11],
                render: function (data, type, row, meta) {
                    let status = row[9];
                    let code = escapeHtml(encodeURIComponent(row[2]));
                    if (status)
                        return '<form method="post" class="d-inline js-gift-card-status-form" action="/admin/module/theliagiftcard/deactivate?code=row_code"><input type="hidden" name="_token" value="{{ assignToken() }}"><button type="submit" class="btn btn-success btn-sm" title="{{ 'Deactivate_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default-twig') }}"><i class="bi bi-power"></i></button></form>'.replace('row_code', code) +
                        '<a class="btn btn-secondary btn-sm show_send_card_gift_dialog" href="#" data-bs-toggle="modal" data-bs-target="#send_gift_card_email" data-id="' + row[0] + '" data-code="' + code + '" title="{{ 'Envoyer'|trans({}, 'theliagiftcard.bo.default-twig') }}"><i class="bi bi-send"></i></a>'.replace('row_code', code).replace('row_code', code);
                    return '<form method="post" class="d-inline js-gift-card-status-form" action="/admin/module/theliagiftcard/activate?code=row_code"><input type="hidden" name="_token" value="{{ assignToken() }}"><button type="submit" class="btn btn-danger btn-sm" title="{{ 'Activate_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default-twig') }}"><i class="bi bi-power"></i></button></form>'.replace('row_code', code);
                }
            },
            {
                targets: [12],
                render: function (data, type, row, meta) {
                    let code = escapeHtml(row[2]);
                    return '<a class="btn btn-secondary btn-sm show_manualy_edit_card_gift_dialog" data-bs-toggle="modal" data-bs-target="#manualy_edit_card_gift_dialog" data-id="' + row[0] + '" data-code="' + code + '" title="{{ 'EDIT_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default-twig') }}"><i class="bi bi-pencil-square"></i></a>';
                }
            }
        ]),
        language: {
            "sProcessing": "{{ 'Processing...'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sSearch": "{{ 'Search'|trans({}, 'theliagiftcard.bo.default-twig') }} ",
            "sLengthMenu": "{{ 'Display _MENU_ elements'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sInfo": "{{ 'Displaying elements _START_ to _END_ of _TOTAL_'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sInfoEmpty": "{{ 'Displaying elements 0 to 0 of 0'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sInfoFiltered": "{{ '(filtered from _MAX_ elements in total)'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sInfoPostFix": "",
            "sLoadingRecords": "{{ 'Loading...'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sZeroRecords": "{{ 'No element to display'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "sEmptyTable": "{{ 'No data available in the table'|trans({}, 'theliagiftcard.bo.default-twig') }}",
            "oPaginate": {
                "sFirst": "{{ 'First'|trans({}, 'theliagiftcard.bo.default-twig') }}",
                "sPrevious": "{{ 'Previous'|trans({}, 'theliagiftcard.bo.default-twig') }}",
                "sNext": "{{ 'Next'|trans({}, 'theliagiftcard.bo.default-twig') }}",
                "sLast": "{{ 'Last'|trans({}, 'theliagiftcard.bo.default-twig') }}"
            },
            "oAria": {
                "sSortAscending": ": {{ 'enable to sort by ascending order'|trans({}, 'theliagiftcard.bo.default-twig') }}",
                "sSortDescending": ": {{ 'enable to sort by descending order'|trans({}, 'theliagiftcard.bo.default-twig') }}"
            }
        }
    });

    $('#js-input-type').on('change', (event) => {
        const value = parseInt(event.currentTarget.value, 10);
        let searchValue = "";

        if (value === 1) {
            searchValue = "ORD";
        }

        if (value === 2) {
            searchValue = "{{ 'Generated by Admin'|trans({}, 'theliagiftcard.bo.default-twig')|e('js') }}";
        }

        table.column(1)
             .search(searchValue)
             .draw();
    });

    function toggleTableLog(table, hidden = true) {
        if (hidden && !table.classList.contains("d-none"))
            table.classList.add("d-none");
        else if (!hidden && table.classList.contains("d-none"))
            table.classList.remove("d-none");
    }

    {# The card the edit window is open on, and the request that reads it: a late answer for a card
       opened before must not fill the window of the next one. #}
    let editedCardCode = null;
    let editedCardRequest = null;

    function forgetEditedCard() {
        editedCardCode = null;
        if (editedCardRequest) {
            editedCardRequest.abort();
            editedCardRequest = null;
        }
    }

    function refreshFormData(code) {
        forgetEditedCard();
        let requestedCode = String(code);
        editedCardCode = requestedCode;

        let form = document.querySelector('#manualy_edit_card_gift_dialog form');
        form.reset();
        $('#amount, #expirationDate, #beneficiaryAddress, #giftCardId').val('');
        buildTableFromLogs([]);

        editedCardRequest = $.ajax({
            method: "POST",
            url: '/admin/module/theliagiftcard/show/' + encodeURIComponent(requestedCode),
            dataType: "json",
            success: function (response) {
                if (requestedCode !== editedCardCode) {
                    return;
                }
                editedCardRequest = null;
                $('#amount').val(response['amount']);
                $('#expirationDate').val(response['expiration_date']);
                $('#beneficiaryAddress').val(response['beneficiary_address']);
                $('#giftCardId').val(response['card_id']);

                buildTableFromLogs(response["HISTORY"] || []);
            }
        });
    }

    function buildTableFromLogs(logs) {
        let tbody = document.getElementById("logs-body");
        if (!tbody) {
            return;
        }
        toggleTableLog(tbody.parentNode.parentNode, false);

        let columns = ['ORDER_REF', 'SPEND_AMOUNT', 'ORDER_STATUS', 'DATE'];
        let html = "";
        let atLeastOne = false;

        jQuery.each(logs, function (key, value) {
            html += "<tr>";
            for (let i = 0; i < columns.length; i++) {
                html += "<td>";
                html += (typeof (value[columns[i]]) != "undefined") ? escapeHtml(value[columns[i]]) : "?";
                html += "</td>";
            }
            html += "</tr>";
            atLeastOne = true;
        });

        if (!atLeastOne) {
            toggleTableLog(tbody.parentNode.parentNode);
        }

        tbody.innerHTML = html;
    }

    $('#send_gift_card_email').on('shown.bs.modal', function (element) {
        $('#giftCardCode').val($(element.relatedTarget).data('code'));
    });

    $('#send_gift_card_email').on('hide.bs.modal', function (element) {
        $('#giftCardCode').val('');
    });

    $('#manualy_edit_card_gift_dialog').on('show.bs.modal', function (e) {
        refreshFormData($(e.relatedTarget).attr('data-code'));
    });

    $('#manualy_edit_card_gift_dialog').on('hide.bs.modal', forgetEditedCard);
</script>

<style>
    #dataTableGiftCard_filter {
        text-align: right;
    }
</style>
