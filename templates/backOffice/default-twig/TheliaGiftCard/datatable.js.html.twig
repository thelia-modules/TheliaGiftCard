{# module.config-js hook fragment.
   Heavy jQuery + DataTables + Select2 + flatpickr table kept from CDN (no clean Stimulus port —
   server-side AJAX DataTable). jQuery loaded from CDN since the default-twig BO ships no jQuery. #}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.6-rc.0/js/select2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.10/lodash.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.16/js/dataTables.bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/flatpickr.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/l10n/fr.js"></script>
<script src="https://cdn.datatables.net/plug-ins/1.10.20/dataRender/ellipsis.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.2/themes/airbnb.css">
<script type="application/javascript">

    var all_info = {{ all_info|json_encode|raw }};

    $('body').on('click', '.status-button', function (e) {
        e.preventDefault();

        let elem = e.currentTarget;
        let url = elem.href;

        elem.setAttribute('disabled', 'disabled');

        $.ajax({
            url: url,
            error: function (e) {

            }
        }).always(function () {
            elem.removeAttribute("disabled");
        });

        $('#dataTableGiftCard').DataTable().ajax.reload(null, false);
    });

    $('body').on('click', '.edit-gc-button', function (e) {
        e.preventDefault();
    });

    var table = $('#dataTableGiftCard').DataTable({
        scrollX: true,
        order: [[0, "desc"]],
        drawCallback: function (oSettings) {
        },
        ajax: '/admin/module/theliagiftcard/show',
        method: 'GET',
        columnDefs: {{ columnsDefinitionTransaction|json_encode|raw }}.concat([
            {
                targets: [0],
                render: function (data, type, row, meta) {
                    return data;
                }
            },
            {
                targets: [1],
                render: function (data, type, row, meta) {
                    return (data) ? `<a href="/admin/order/update/` + data + `">` + all_info['orders'][data] + `</a>` : "{{ 'Generated by Admin'|trans({}, 'theliagiftcard.bo.default') }}";
                }
            },
            {
                targets: [3],
                render: function (data, type, row, meta) {
                    return (data) ? all_info['sponsor_customers'][data] : "{{ thelia_config('store_name', '') }}";
                }
            },
            {
                targets: [4],
                render: function (data, type, row, meta) {
                    return (data) ? all_info['beneficiary_customers'][data] : "{{ 'Not used'|trans({}, 'theliagiftcard.bo.default') }}";
                }
            },
            {
                targets: [9],
                render: function (data, type, row, meta) {
                    return (!data) ? "{{ 'Not active'|trans({}, 'theliagiftcard.bo.default') }}" : "{{ 'Active'|trans({}, 'theliagiftcard.bo.default') }}";
                }
            },
            {
                targets: [10],
                render: function (data, type, row, meta) {
                    let status = row[9];
                    let code = row[2];
                    if (status) {
                        let whole_msg = '';
                        {% for lang in all_info.languages %}
                        whole_msg += '<a class="btn btn-secondary btn-sm" ' +
                            'href="/admin/module/theliagiftcard/config/send/pdf?l={{ lang.locale }}&code=' + code + '" ' +
                            'title="{{ 'GENERATE_PDF_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default') }}" ' +
                            'target="_blank">{{ lang.code }}</a> ';
                        {% endfor %}
                        return whole_msg;
                    } else
                        return "";
                }
            },
            {
                targets: [11],
                render: function (data, type, row, meta) {
                    let status = row[9];
                    let code = row[2];
                    if (status)
                        return '<a class="btn status-button btn-success btn-sm" href="/admin/module/theliagiftcard/deactivate?code=row_code" title="{{ 'Deactivate_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default') }}"><i class="bi bi-power"></i></a>'.replace('row_code', code) +
                        '<a class="btn status-button btn-secondary btn-sm show_send_card_gift_dialog" href="#" data-bs-toggle="modal" data-bs-target="#send_gift_card_email" data-id="' + row[0] + '" data-code="' + code + '" title="{{ 'Envoyer'|trans({}, 'theliagiftcard.bo.default') }}"><i class="bi bi-send"></i></a>'.replace('row_code', code).replace('row_code', code);
                    return '<a class="btn status-button btn-danger btn-sm" href="/admin/module/theliagiftcard/activate?code=row_code" title="{{ 'Activate_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default') }}"><i class="bi bi-power"></i></a>'.replace('row_code', code);
                }
            },
            {
                targets: [12],
                render: function (data, type, row, meta) {
                    let code = row[2];
                    return '<a class="btn status-button btn-secondary btn-sm show_manualy_edit_card_gift_dialog" data-bs-toggle="modal" data-bs-target="#manualy_edit_card_gift_dialog" data-id="' + row[0] + '" data-code="' + code + '" title="{{ 'EDIT_GIFT_CARD'|trans({}, 'theliagiftcard.bo.default') }}"><i class="bi bi-pencil-square"></i></a>';
                }
            }
        ]),
        language: {
            "sProcessing": "{{ 'Processing...'|trans({}, 'theliagiftcard.bo.default') }}",
            "sSearch": "{{ 'Search'|trans({}, 'theliagiftcard.bo.default') }} ",
            "sLengthMenu": "{{ 'Display'|trans({}, 'theliagiftcard.bo.default') }} _MENU_ {{ 'elements'|trans({}, 'theliagiftcard.bo.default') }}",
            "sInfo": "{{ 'Displaying elements from'|trans({}, 'theliagiftcard.bo.default') }} _START_ {{ 'to'|trans({}, 'theliagiftcard.bo.default') }} _END_ {{ 'on'|trans({}, 'theliagiftcard.bo.default') }} _TOTAL_ {{ 'elements'|trans({}, 'theliagiftcard.bo.default') }}",
            "sInfoEmpty": "{{ 'Displaying elements from'|trans({}, 'theliagiftcard.bo.default') }} 0 {{ 'to'|trans({}, 'theliagiftcard.bo.default') }} _END_ {{ 'on'|trans({}, 'theliagiftcard.bo.default') }} _TOTAL_ {{ 'elements'|trans({}, 'theliagiftcard.bo.default') }}",
            "sInfoFiltered": "({{ 'filtered from'|trans({}, 'theliagiftcard.bo.default') }} _MAX_ {{ 'elements'|trans({}, 'theliagiftcard.bo.default') }} {{ 'in total'|trans({}, 'theliagiftcard.bo.default') }})",
            "sInfoPostFix": "",
            "sLoadingRecords": "{{ 'Loading...'|trans({}, 'theliagiftcard.bo.default') }}",
            "sZeroRecords": "{{ 'No element to display'|trans({}, 'theliagiftcard.bo.default') }}",
            "sEmptyTable": "{{ 'No data available in the table'|trans({}, 'theliagiftcard.bo.default') }}",
            "oPaginate": {
                "sFirst": "{{ 'First'|trans({}, 'theliagiftcard.bo.default') }}",
                "sPrevious": "{{ 'Previous'|trans({}, 'theliagiftcard.bo.default') }}",
                "sNext": "{{ 'Next'|trans({}, 'theliagiftcard.bo.default') }}",
                "sLast": "{{ 'Last'|trans({}, 'theliagiftcard.bo.default') }}"
            },
            "oAria": {
                "sSortAscending": ": {{ 'enable to sort by ascending order'|trans({}, 'theliagiftcard.bo.default') }}",
                "sSortDescending": ": {{ 'enable to sort by descending order'|trans({}, 'theliagiftcard.bo.default') }}"
            }
        }
    });

    $('#js-input-type').on('change', (event) => {
        const value = parseInt(event.currentTarget.value, 10);
        let searchValue = "";

        if (value === 1) {
            searchValue = "ORD";
        }

        if (value === 2) {
            searchValue = "{{ 'Generated by Admin'|trans({}, 'theliagiftcard.bo.default') }}";
        }

        table.column(1)
             .search(searchValue)
             .draw();
    });

    function toggleTableLog(table, hidden = true) {
        if (hidden && !table.classList.contains("d-none"))
            table.classList.add("d-none");
        else if (!hidden && table.classList.contains("d-none"))
            table.classList.remove("d-none");
    }

    function refreshFormData(code, specified = null) {
        $.ajax({
            method: "POST",
            url: '/admin/module/theliagiftcard/show/' + code,
            dataType: "json",
            success: function (response) {
                $('#amount').val(response['amount']);
                $('#expirationDate').val(response['expiration_date']);
                $('#beneficiaryAddress').val(response['beneficiary_address']);
                $('#giftCardId').val(response['card_id']);

                buildTableFromLogs(response["HISTORY"]);
            }
        });
    }

    function buildTableFromLogs(logs) {
        let tbody = document.getElementById("logs-body");
        if (!tbody) {
            return;
        }
        toggleTableLog(tbody.parentNode.parentNode, false);

        let columns = ['ORDER_REF', 'SPEND_AMOUNT', 'ORDER_STATUS', 'DATE'];
        let html = "";
        let atLeastOne = false;

        jQuery.each(logs, function (key, value) {
            html += "<tr>";
            for (let i = 0; i < columns.length; i++) {
                html += "<td>";
                html += (typeof (value[columns[i]]) != "undefined") ? value[columns[i]] : "?";
                html += "</td>";
            }
            html += "</tr>";
            atLeastOne = true;
        });

        if (!atLeastOne) {
            toggleTableLog(tbody.parentNode.parentNode);
        }

        tbody.innerHTML = html;
    }

    $('.show_manualy_edit_card_gift_dialog').on('click', function () {
        $('#giftCardId').val($(this).attr('id'));
    });

    $('#send_gift_card_email').on('shown.bs.modal', function (element) {
        $('#giftCardCode').val($(element.relatedTarget).data('code'));
    });

    $('#send_gift_card_email').on('hide.bs.modal', function (element) {
        $('#giftCardCode').val('');
    });

    $('#manualy_edit_card_gift_dialog').on('show.bs.modal', function (e) {
        var code = $(e.relatedTarget).data('code');
        refreshFormData(code);
    });
</script>

<style>
    #dataTableGiftCard_filter {
        text-align: right;
    }
</style>
