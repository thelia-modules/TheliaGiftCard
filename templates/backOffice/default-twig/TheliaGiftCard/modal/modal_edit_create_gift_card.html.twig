{# Edit a gift card modal — form: edit_gift_card #}
<div class="modal fade" id="manualy_edit_card_gift_dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="/admin/module/theliagiftcard/edit-gift-card" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Edit a gift card'|trans({}, 'theliagiftcard.bo.default-twig') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h4>{{ 'Gift Card Informations'|trans({}, 'theliagiftcard.bo.default-twig') }}</h4>

                    {{ form_errors(form) }}

                    {{ form_widget(form.success_url, { value: app.request.uri }) }}
                    {{ form_widget(form.gift_card_id, { id: 'giftCardId', type: 'hidden' }) }}

                    <div class="row">
                        <div class="col-sm-12 mb-3">
                            {{ form_label(form.beneficiary_address) }}
                            {{ form_widget(form.beneficiary_address, { id: 'beneficiaryAddress', attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.beneficiary_address) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            {{ form_label(form.expiration_date) }}
                            {{ form_widget(form.expiration_date, { id: 'expirationDate', attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.expiration_date) }}
                        </div>
                        <div class="col-sm-6 mb-3">
                            {{ form_label(form.amount) }}
                            {{ form_widget(form.amount, { id: 'amount', attr: { class: 'form-control', step: 'any' } }) }}
                            {{ form_errors(form.amount) }}
                        </div>
                    </div>
                    <div class="table-responsive d-none">
                        <h4>{{ 'Usage history'|trans({}, 'theliagiftcard.bo.default-twig') }}</h4>
                        <table class="table table-striped table-sm">
                            <thead>
                            <tr>
                                <th>{{ 'Order reference'|trans({}, 'theliagiftcard.bo.default-twig') }}</th>
                                <th>{{ 'Amount spent'|trans({}, 'theliagiftcard.bo.default-twig') }}</th>
                                <th>{{ 'Order status'|trans({}, 'theliagiftcard.bo.default-twig') }}</th>
                                <th>{{ 'Date'|trans({}, 'theliagiftcard.bo.default-twig') }}</th>
                            </tr>
                            </thead>
                            <tbody id="logs-body"></tbody>
                        </table>
                    </div>
                    {{ form_rest(form) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        {{ 'Cancel'|trans({}, 'theliagiftcard.bo.default-twig') }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        {{ 'Save'|trans({}, 'theliagiftcard.bo.default-twig') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
